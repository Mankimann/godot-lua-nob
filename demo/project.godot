; Engine configuration file.
; This demo targets Godot 4.5+.

config_version=5

[application]
config/name="Godot Lua Nob Demo"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GDExtension")

[editor_plugins]
enabled=PackedStringArray("res://addons/godot_lua_editor/plugin.cfg")
